# ==============================================================================
# G-AI WEB APPLICATION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Sao chép tệp này thành .env.local và điền API Key thực tế của bạn:
# cp .env.example .env.local
# ==============================================================================

# Google Gemini API Key
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Image-to-Image Editing Model
# Mô hình Gemini nhận ảnh Day 0 + prompt chỉnh sửa và trả về ảnh đã biến đổi
# Tùy chọn hiện hành: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-exp
IMAGE_MODEL=gemini-2.5-flash

# Multimodal Vision Analysis Model
# Dùng để phân tích đặc điểm nhân diện và độ lệch tư thế từ ảnh ban đầu
VISION_MODEL=gemini-1.5-flash

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
