# ==============================================================================
# G-AI WEB APPLICATION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Sao chép tệp này thành .env.local và điền API Key thực tế của bạn:
# cp .env.example .env.local
# ==============================================================================

# ---- Photo prediction provider ---------------------------------------------
# Order: Gemini (if GEMINI_API_KEY) -> Cloudflare Workers AI (if both CLOUDFLARE_* set)
# -> none (illustrative preset images, no AI call). Force one with IMAGE_PROVIDER=gemini|cloudflare|none
# IMAGE_PROVIDER=

# Cloudflare Workers AI (free daily allowance). Token needs the "Workers AI: Read" permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

# Google Gemini API Key
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Image-to-Image Editing Model
# Mô hình Gemini nhận ảnh Day 0 + prompt chỉnh sửa và trả về ảnh đã biến đổi
# Tùy chọn hiện hành: gemini-2.5-flash-image, gemini-3.1-flash-image
IMAGE_MODEL=gemini-2.5-flash-image

# Multimodal Vision Analysis Model
# Dùng để phân tích đặc điểm nhân diện và độ lệch tư thế từ ảnh ban đầu
# Tùy chọn hiện hành: gemini-3-flash-preview, gemini-2.5-flash-image
VISION_MODEL=gemini-3-flash-preview

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the brand site (logo and store links point here)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Signs short-lived links to generated prediction images (>= 32 chars, required in production)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PREDICTION_SIGNING_SECRET=

# Private directory for generated prediction images (default: ./.data/predictions, never under public/)
# PREDICTION_STORAGE_DIR=

# FastAPI backend that /api/v1/* is proxied to (server-side; resolved at build time)
BACKEND_URL=http://localhost:8000

# Public URL of the main hub site (every product logo links here)
NEXT_PUBLIC_HUB_URL=http://localhost:3002
