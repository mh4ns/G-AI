# cp .env.example .env  (read by app/core/config.py)
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./g_ai.db
# Supabase: paste the pooler string as-is, e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Port 6543 (transaction pooler) disables prepared statements automatically; override with DB_TRANSACTION_POOLER=true|false.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
AUTO_CREATE_SCHEMA=true
# Required (>= 32 random chars) when ENVIRONMENT=production
SECRET_KEY=
AUTH_COOKIE_SECURE=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reverse proxies that append to X-Forwarded-For (Vercel rewrite + Render = 2). 0 = ignore the header.
TRUSTED_PROXY_HOPS=0
