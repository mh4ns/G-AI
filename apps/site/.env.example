# Public URL of the coaching app (quiz, prediction, today). Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of this site (used for metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public URL of the main hub site (every product logo links here)
NEXT_PUBLIC_HUB_URL=http://localhost:3002

# Store prices, the bag and checkout stay hidden until launch prices are
# confirmed. Set to "true" to show them.
NEXT_PUBLIC_STORE_PRICES=false
